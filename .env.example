# Kalshi
KALSHI_API_KEY=your-kalshi-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
KALSHI_TICKERS=KXFED-25JAN29,KXCPI-25FEB
KALSHI_DEBUG_AUTH=0
KALSHI_USE_WEBSOCKET=true   # set to false to force REST polling (for debugging)

# Polymarket
POLYMARKET_API_KEY=your-polymarket-api-key-here
POLYMARKET_ADDRESS=0xYourWalletAddressHere
POLYMARKET_CONDITION_IDS=

# Execution
EXECUTION_MODE=mock
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Signal tuning
VELOCITY_THRESHOLD=0.15
VELOCITY_WINDOW_MINUTES=5
DEDUP_WINDOW_MINUTES=30
POLL_INTERVAL_SECONDS=30
EXIT_CHECK_INTERVAL_SECONDS=60

# Position sizing
PORTFOLIO_VALUE=10000
MAX_POSITION_PCT=0.05

# Alerting — accepts both Discord and Slack incoming webhook URLs
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL
# Slack: App → Incoming Webhooks → Add New Webhook to Workspace
ALERT_WEBHOOK_URL=
ALERTS_ENABLED=true

# Backtesting execution model
BACKTEST_SLIPPAGE_BPS=10     # entry/exit slippage per side in basis points
BACKTEST_LATENCY_SECONDS=5   # seconds between signal fire and fill
BACKTEST_SPREAD_BPS=5        # one-way spread cost at entry and exit

# Confidence decay
CONFIDENCE_DECAY_ENABLED=true  # set to false to use static confidence values

# ─────────────────────────────────────────────────────────────────────────────
# PRISM CONNECTORS
# Each .prism connector reads its own env vars. Add values below to activate.
# ─────────────────────────────────────────────────────────────────────────────

# metaculus_macro — Metaculus Macro Questions (no auth required)
# Comma-separated Metaculus question IDs to track
METACULUS_QUESTION_IDS=
# Maps question ID → contract slug, e.g. "12345:KXFED,67890:KXCPI"
METACULUS_SLUG_MAP=
# Poll interval in seconds (default 300 = 5 minutes)
METACULUS_POLL_INTERVAL_SECONDS=300

# manifold_macro — Manifold Markets Macro (no auth required)
# Comma-separated Manifold market slugs to track
MANIFOLD_MARKET_IDS=
# Maps market slug → contract slug, e.g. "will-the-fed-cut-in-2026:KXFED"
MANIFOLD_SLUG_MAP=
# Poll interval in seconds (default 120 = 2 minutes)
MANIFOLD_POLL_INTERVAL_SECONDS=120

# fred_macro — FRED Macro Indicators (auth required)
# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Comma-separated FRED series IDs to track, e.g. "FEDFUNDS,CPIAUCSL,UNRATE"
FRED_SERIES=FEDFUNDS,CPIAUCSL,UNRATE
# Maps series ID → contract slug, e.g. "FEDFUNDS:KXFED,CPIAUCSL:KXCPI,UNRATE:KXJOBS"
FRED_SERIES_SLUG_MAP=FEDFUNDS:KXFED,CPIAUCSL:KXCPI,UNRATE:KXJOBS
# Poll interval in seconds (default 3600 = 1 hour; FRED updates at most daily)
FRED_POLL_INTERVAL_SECONDS=3600
